# SC-EVM Environment Configuration Example
# Copy this file to '.env' and populate with your credentials.

# --- Required API Keys ---
# Local API keys for the NVIDIA NIM transport.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_KEY_QWEN=your_qwen_specific_api_key_here
NVIDIA_API_KEY_KIWI=your_kiwi_specific_api_key_here

# --- NVIDIA NIM Endpoint and Model Registry ---
NVIDIA_NIM_CHAT_COMPLETIONS_URL=https://integrate.api.nvidia.com/v1/chat/completions
MODEL_1_KEY=nemotron
MODEL_2_KEY=core
MODEL_1_FLASH=nvidia/nemotron-3-nano-30b-a3b
MODEL_2_CORE=openai/gpt-oss-120b
MODEL_1_ALIASES=["qwen","model_1","model1"]
MODEL_2_ALIASES=["gpt_oss","gpt-oss","openai","kiwi","model_2","model2"]
MODEL_1_TEMPERATURE=0.7
MODEL_1_TOP_P=0.8
MODEL_2_TEMPERATURE=1.0
MODEL_2_TOP_P=1.0
MODEL_CANDIDATE_MAX_TOKENS=2048
MODEL_REFORMULATION_MAX_TOKENS=1024
MODEL_SYNTHESIS_MAX_TOKENS=1536

# --- Server Settings ---
# Local REST API server configuration.
# The server runs on localhost (127.0.0.1) by default for security.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
MAX_WORKER_THREADS=8
COMMAND_TIMEOUT_SECONDS=300
IPC_MAX_PAYLOAD_BYTES=1048576
WORKSPACE_MAX_FILE_BYTES=2097152

# --- Lifecycle and GC ---
GC_TTL_SECONDS=3600
GC_INTERVAL_SECONDS=300
MAX_ACTIVE_SESSIONS=1024
MAX_HISTORY_TURNS=6
SESSION_TOKEN_BUDGET=2500
AUDIT_LOG_PATH=~/.config/anthropic-agent/audit.log

# --- Telemetry & Diagnostics ---
# Enable/disable diagnostic print streams.
DIAGNOSTIC_MODE=false
TELEMETRY_ENABLED=true
TELEMETRY_REDACT_CONTENT=true
TELEMETRY_MAX_FILE_SIZE_BYTES=10485760

# --- Provider Request Limits ---
NVIDIA_MAX_TOKENS=4096
NVIDIA_MAX_RETRIES=3
NVIDIA_CONNECT_TIMEOUT_SECONDS=3
NVIDIA_READ_TIMEOUT_SECONDS=60
NVIDIA_WRITE_TIMEOUT_SECONDS=45
NVIDIA_POOL_TIMEOUT_SECONDS=5
NVIDIA_READ_TIMEOUT_RETRIES=1
NVIDIA_MAX_CONNECTIONS=64
NVIDIA_MAX_KEEPALIVE_CONNECTIONS=64

# --- Retrieval and Dual-Anchor Distance Policy ---
RETRIEVAL_RESULT_LIMIT=3
RETRIEVAL_BASE_DISTANCE_THRESHOLD=0.52
RETRIEVAL_ABSOLUTE_DISTANCE_CEILING=0.48
RETRIEVAL_ABSOLUTE_DISTANCE_FLOOR=0.38
RETRIEVAL_NEIGHBOR_DELTA_LIMIT=0.12
RETRIEVAL_TOP_ANCHOR_DELTA_LIMIT=0.18
RETRIEVAL_CALIBRATION_WEIGHT=0.3
RETRIEVAL_MIN_DISTANCE_THRESHOLD=0.1
RETRIEVAL_MAX_DISTANCE_THRESHOLD=0.9

# --- Optional Local Clients ---
SC_EVM_BASE_URL=http://127.0.0.1:8000
SC_EVM_SINGLE_MODEL_BASE_URL=http://127.0.0.1:8001
SC_EVM_SESSION_ID=cli-tui-session-001
SC_EVM_SANDBOX_ROOT=./sandboxes
